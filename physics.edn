;; What this vertical's robot physically does, declared for
;; kotoba.robotics.process (kotoba-lang/robotics). `kbb -M:physics` runs it.
;;
;; README "Robotics premise": a document-scanning robot performs physical
;; document feeding and OCR-assist scanning (ISCO 4132). Its physical work is
;; lifting paper stacks into the sheet feeder, and carrying document boxes to
;; the scanning station.
;;
;; Every number without a cited source is marked `estimate` in its :basis.
{:physics/schema "itonami.physical-ai.spec.v1"
 :repo "cloud-itonami/cloud-itonami-isco-4132"
 :cases
 [{:id :paper-stack-to-feeder
   :kind :manipulator
   :procedure "desktop arm lifts a stack of source forms from the in-tray into the scanner's sheet feeder"
   :params {:l1-m 0.30 :l2-m 0.25 :m1-kg 1.5 :m2-kg 1.0
            :from [0.40 0.05] :to [0.15 0.40] :duration-s 1.5 :steps 300}
   :sweep {:param :payload-kg :values [0.25 0.5 1.0 2.5 3.5]}
   :quantity :peak-tau1-nm
   :limit {:max 15.0 :basis "estimate: continuous shoulder torque of a desktop arm (~1-3 kg class)"}
   :boundary {:lo 0.05 :hi 10.0}}
  {:id :document-box-to-scanning-station
   :kind :transport
   :procedure "robot carries a box of forms from the mail room to the data-entry scanning station"
   :params {:mass-kg 45.0 :payload-kg 12.0 :v-max-mps 1.0 :a-max-mps2 0.5
            :brake-decel-mps2 0.8 :drive-force-n 90.0 :crr 0.02
            :cog-height-m 0.55 :support-half-length-m 0.25}
   :sweep {:param :distance-m :values [20.0 40.0 80.0 120.0 200.0]}
   :quantity :cycle-time-s
   :limit {:max 90.0 :basis "estimate: the next box must arrive before the feeder empties (about 90 s at batch-scan speed)"}
   :boundary {:lo 5.0 :hi 600.0}}]}
